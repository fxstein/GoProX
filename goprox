  source="$volume"
  
  # Preserve force mode settings
  local original_force=$FORCE
  local original_force_scopes=("${force_scopes[@]}")
  
  # Call the existing clean function
  _clean_media
  
  # Restore original settings
  clean=$original_clean
  source=$original_source
  FORCE=$original_force
  force_scopes=("${original_force_scopes[@]}")
}

