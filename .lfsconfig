[lfs]
    # Ensure LFS objects are fetched during checkout
    fetchrecentrefsdays = 7
    fetchrecentremoterefs = true
    fetchrecentcommitsdays = 7
    
    # Configure batch size for better performance
    batchsize = 100
    
    # Ensure LFS objects are downloaded during fetch
    fetchinclude = *
    fetchexclude = 
    
    # Configure LFS to be more aggressive about downloading
    skipdownloaderrors = false 